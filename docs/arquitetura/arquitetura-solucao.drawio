a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="user" target="ios" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-e4" value="Usa&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="user" target="web" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-e5" value="Lê e grava&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[JSON]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="ios" target="file" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-e6" value="Publica resumo para&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[App Group]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" source="ios" target="wid" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-e7" value="Envia resumo para&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[WatchConnectivity]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" source="ios" target="wat" parent="1"><mxGeometry relative="