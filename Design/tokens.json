{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Tokens do App Finanças, direção visual Cédula. Cores têm valor claro (light) e escuro (dark). Nomes em camelCase batem 1:1 com os Color Sets do Asset Catalog (Assets.xcassets/Colors/<nome>) e com as variáveis CSS do protótipo (--<nome-em-kebab>).",
  "meta": {
    "name": "Cédula",
    "version": "1.0.0",
    "updated": "2026-10-19",
    "locale": "pt-BR",
    "currency": "BRL",
    "contrastStandard": "WCAG 2.1 AA (texto 4.5:1, componentes/gráficos 3:1), verificado por script"
  },

  "color": {
    "$type": "color",
    "background": {
      "canvas":        { "light": "#EEF2EF", "dark": "#0E1513", "$description": "Fundo das telas (papel de algodão frio, não creme)" },
      "surface":       { "light": "#FFFFFF", "dark": "#17201D", "$description": "Grupos de lista, sheets" },
      "surfaceRaised": { "light": "#FFFFFF", "dark": "#1F2A26", "$description": "Elementos sobre surface: teclado, popovers" },
      "sunken":        { "light": "#E3E9E5", "dark": "#0A100E", "$description": "Campos, trilhos de barra, segmentado" }
    },
    "text": {
      "primary":   { "light": "#15241F", "dark": "#E7EEEA", "$description": "Texto e valores de despesa" },
      "secondary": { "light": "#4B5B55", "dark": "#A9B7B1" },
      "tertiary":  { "light": "#56645F", "dark": "#8D9C96", "$description": "Metadados; ainda passa 4.5:1 em todos os fundos" },
      "onBrand":   { "light": "#FFFFFF", "dark": "#06292B" },
      "onDanger":  { "light": "#FFFFFF", "dark": "#2A0B08" }
    },
    "line": {
      "separator": { "light": "#CDD6D1", "dark": "#2C3934", "$description": "Hairline decorativa (0.5pt). Não carrega informação." },
      "border":    { "light": "#7F8E88", "dark": "#6F7F79", "$description": "Contorno de controles (>= 3:1)" }
    },
    "brand": {
      "primary": { "light": "#0D5C63", "dark": "#5CC2C6", "$description": "Petróleo. Ações, seleção, foco, transferências" },
      "soft":    { "light": "#D8EAE8", "dark": "#173A3B", "$description": "Fundo de chip selecionado" }
    },
    "focus": { "light": "#0D5C63", "dark": "#5CC2C6", "$description": "Anel de foco 2pt + 2pt de afastamento" },

    "semantic": {
      "income":      { "light": "#176E3C", "dark": "#57C98A", "$description": "Receita. Sempre acompanhada de sinal +" },
      "incomeSoft":  { "light": "#DDF0E3", "dark": "#16301F" },
      "expense":     { "light": "#15241F", "dark": "#E7EEEA", "$description": "Despesa = text.primary com sinal −. Vermelho fica reservado para problema real" },
      "transfer":    { "light": "#0D5C63", "dark": "#5CC2C6" },
      "warning":     { "light": "#8A5A00", "dark": "#F2B551", "$description": "Texto de alerta (orçamento >= 80%, vence em <= 3 dias)" },
      "warningFill": { "light": "#A86A06", "dark": "#E8A33D", "$description": "Preenchimento de barra em alerta (>= 3:1 no trilho)" },
      "warningSoft": { "light": "#FBEBCF", "dark": "#3A2C12" },
      "danger":      { "light": "#B42318", "dark": "#FF8B7E", "$description": "Saldo negativo, orçamento estourado (>= 100%), conta atrasada" },
      "dangerSoft":  { "light": "#FBE3DF", "dark": "#3D1D1A" },
      "neutral":     { "light": "#56645F", "dark": "#8D9C96", "$description": "Pendente, sem categoria, informativo" }
    },

    "category": {
      "$description": "Paleta das cédulas do Real (2ª família). Cada cor >= 3:1 contra surface e trilho nos dois modos. Uso: ícone de categoria, barras do gráfico. Nunca como única pista: sempre com rótulo.",
      "moradia":    { "light": "#2E7D78", "dark": "#56B3AD", "note": "R$ 100, garoupa" },
      "mercado":    { "light": "#B86F0B", "dark": "#E7A443", "note": "R$ 20, mico-leão-dourado" },
      "transporte": { "light": "#3A6EA5", "dark": "#77A6DA", "note": "R$ 2, tartaruga" },
      "lazer":      { "light": "#7653A8", "dark": "#A88BD6", "note": "R$ 5, garça" },
      "saude":      { "light": "#B8456A", "dark": "#E07C9E", "note": "R$ 10, arara" },
      "educacao":   { "light": "#8E6236", "dark": "#C79A6A", "note": "R$ 50, onça-pintada" },
      "outros":     { "light": "#6E7479", "dark": "#9BA2A8", "note": "R$ 200, lobo-guará" }
    }
  },

  "typography": {
    "$description": "SF Pro (sistema). Todos os estilos usam Dynamic Type: em SwiftUI use os TextStyle nativos; tamanhos customizados com @ScaledMetric(relativeTo:). Valores em pt no tamanho padrão (Large).",
    "fontFamily": {
      "text":    "SF Pro Text (sistema, .default)",
      "display": "SF Pro Display (sistema, automático >= 20pt)",
      "cssStack": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', system-ui, sans-serif"
    },
    "style": {
      "largeTitle":  { "size": 34, "lineHeight": 41, "weight": 700, "tracking": 0.4,  "swiftUI": ".largeTitle.bold()" },
      "title1":      { "size": 28, "lineHeight": 34, "weight": 700, "tracking": 0.38, "swiftUI": ".title.bold()" },
      "title2":      { "size": 22, "lineHeight": 28, "weight": 600, "tracking": -0.26, "swiftUI": ".title2.weight(.semibold)" },
      "title3":      { "size": 20, "lineHeight": 25, "weight": 600, "tracking": -0.45, "swiftUI": ".title3.weight(.semibold)" },
      "headline":    { "size": 17, "lineHeight": 22, "weight": 600, "tracking": -0.43, "swiftUI": ".headline" },
      "body":        { "size": 17, "lineHeight": 22, "weight": 400, "tracking": -0.43, "swiftUI": ".body" },
      "callout":     { "size": 16, "lineHeight": 21, "weight": 400, "tracking": -0.31, "swiftUI": ".callout" },
      "subheadline": { "size": 15, "lineHeight": 20, "weight": 400, "tracking": -0.23, "swiftUI": ".subheadline" },
      "footnote":    { "size": 13, "lineHeight": 18, "weight": 400, "tracking": -0.08, "swiftUI": ".footnote" },
      "caption1":    { "size": 12, "lineHeight": 16, "weight": 400, "tracking": 0,    "swiftUI": ".caption" },
      "caption2":    { "size": 11, "lineHeight": 13, "weight": 400, "tracking": 0.06, "swiftUI": ".caption2" }
    },
    "amount": {
      "$description": "Estilos de valores monetários. Sempre .monospacedDigit(). 'Split' = inteiro grande, R$ e centavos a 45% do tamanho, alinhados pelo topo (assinatura visual do app).",
      "hero":    { "size": 48, "weight": 600, "tracking": -1.2, "split": true,  "minorScale": 0.45, "relativeTo": "largeTitle", "use": "Saldo do mês no Início, valor no teclado do Novo lançamento" },
      "large":   { "size": 28, "weight": 600, "tracking": -0.5, "split": true,  "minorScale": 0.55, "relativeTo": "title", "use": "Fatura atual, total de conta, meta" },
      "row":     { "size": 17, "weight": 500, "tracking": -0.43, "split": false, "relativeTo": "body", "use": "Valores em linhas de lista" },
      "caption": { "size": 13, "weight": 500, "tracking": -0.08, "split": false, "relativeTo": "footnote", "use": "Valores secundários (limite, orçado de)" }
    }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "Base 4pt.",
    "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 24, "xxxl": 32, "huge": 48,
    "screenMargin": 20,
    "rowVertical": 12,
    "rowMinHeight": 52,
    "sectionGap": 28,
    "minTouchTarget": 44
  },

  "radius": {
    "$type": "dimension",
    "$description": "Hierarquia: quanto maior o contêiner, maior o raio. Use RoundedRectangle(style: .continuous).",
    "xs": 6, "sm": 10, "md": 14, "lg": 20, "sheet": 28, "full": 999,
    "usage": { "chip": "full", "tag": "xs", "input": "sm", "keypadKey": "sm", "listGroup": "md", "highlight": "lg", "sheet": "sheet", "progressBar": "full" }
  },

  "shadow": {
    "$description": "Sombra só em elementos flutuantes. No escuro, elevação vem da cor de superfície, não de sombra.",
    "none":   { "light": "none", "dark": "none" },
    "float":  { "light": { "x": 0, "y": 6, "blur": 20, "color": "#15241F", "opacity": 0.10 }, "dark": "none", "use": "Botão + da tab bar, toast" },
    "sheet":  { "light": { "x": 0, "y": -2, "blur": 24, "color": "#15241F", "opacity": 0.12 }, "dark": "none", "use": "Sheets e teclado" }
  },

  "motion": {
    "fast": 0.15, "standard": 0.25, "sheet": 0.35,
    "curve": "easeOut / .snappy",
    "reduceMotion": "Trocar deslocamentos por fade; desligar animação de contagem do saldo"
  },

  "numberFormat": {
    "locale": "pt_BR",
    "pattern": "R$ 1.234,56 (espaço inseparável U+00A0 após R$; milhar com ponto, decimal com vírgula)",
    "minusSign": "U+2212 (−), antes do R$: −R$ 45,90",
    "plusSign": "+ antes do R$ só em receitas em listas: +R$ 5.200,00",
    "digits": "Sempre tabulares (.monospacedDigit() / font-variant-numeric: tabular-nums)",
    "alignment": "Valores alinhados à direita em linhas; rótulo à esquerda",
    "colorRules": {
      "income": "semantic.income com +",
      "expense": "text.primary com −",
      "transfer": "brand.primary, sem sinal, ícone de setas",
      "negativeBalance": "semantic.danger com −",
      "zero": "text.secondary"
    },
    "privacyMask": "R$ •••• (mesma largura aproximada; VoiceOver lê 'valor oculto')",
    "voiceOver": "Ler por extenso: 'menos 45 reais e 90 centavos'. Não ler o símbolo −."
  }
}
