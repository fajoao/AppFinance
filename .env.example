# Copie para .env e preencha (o .env real NÃO vai para o git). Gere segredos com:  openssl rand -hex 32
POSTGRES_USER=finance
POSTGRES_DB=finance
POSTGRES_PASSWORD=troque-por-openssl-rand-hex-24
JWT_SECRET=troque-por-openssl-rand-hex-48

# Origens permitidas por CORS, separadas por vírgula (vazio = nenhuma; o app web usa o proxy /api, mesma origem).
# Ex.: https://financas.seudominio.com
CORS_ORIGINS=
# true quando a API fica atrás de proxy/túnel (IP real vem de X-Forwarded-For). Não exponha a porta da API direto à internet.
TRUST_PROXY=true
LOG_LEVEL=info

# Portas no host (sempre ligadas a 127.0.0.1)
DB_HOST_PORT=5433
API_HOST_PORT=3000

# Túnel: alvo do quick tunnel (padrão só a API; use http://web:80 para expor o app web, que faz proxy de /api)
TUNNEL_TARGET=http://api:3000
# Túnel nomeado (opcional): token do túnel criado no painel Cloudflare Zero Trust
TUNNEL_TOKEN=
